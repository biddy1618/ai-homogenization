.venv/
__pycache__/
*.pyc

# Secrets — API keys etc. Never commit.
.secrets/
*.key

# Stack Exchange data dumps (kept local, never committed) — root-level only, so
# artifacts/<corpus>/data/ metric CSVs are still committed
/data/
*.7z
*.xml

# Tracker page-text cache (local scratch for full-page recompute; not committed)
tracker/data/pagecache/

# Derived Overleaf upload bundle (rebuild from paper/)
paper/overleaf-upload.zip

# Local tool binaries (Tectonic LaTeX engine)
/tools/

# LaTeX build byproducts (keep main.pdf)
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc

# macOS
.DS_Store
